# Sao chép thành /etc/myagent/contact-api.env (chmod 600, owner root:myagent-contact). KHÔNG commit file thật.
CONTACT_HOST=127.0.0.1
CONTACT_PORT=8787
CONTACT_ALLOWED_ORIGINS=https://myagentvn.com,https://www.myagentvn.com
CONTACT_RATE_N=5
CONTACT_RATE_WINDOW=600
# Telegram (kênh chính): token từ @BotFather, chat id của Peter (lấy qua getUpdates sau khi Peter nhắn /start cho bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=4
