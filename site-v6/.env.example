# Server only. Leave unset in preview to disable real contact/tracking forwarding.
# Backend must be distinct, HTTPS, with no redirects back to this app.
MYAGENT_PUBLIC_ORIGIN=
MYAGENT_BACKEND_ORIGIN=
# Backend POST /api/tracking verifies a random, revocable code and returns one customer-safe order.
MYAGENT_TRACKING_API_TOKEN=
# Shared Redis REST API: atomic EVAL/SET NX EX/DEL, TLS. Required for production APIs.
MYAGENT_REDIS_REST_URL=
MYAGENT_REDIS_REST_TOKEN=
# Only use an IP header that your trusted edge OVERWRITES. Empty = shared client bucket.
MYAGENT_TRUSTED_IP_HEADER=
# LOCAL automated QA only; bypasses distributed Redis with process-local limits. Never production.
MYAGENT_LOCAL_QA=
